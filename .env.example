# 이 파일을 .env로 복사한 뒤 실제 값으로 채우세요.
#   copy .env.example .env       (명령 프롬프트)
#   cp .env.example .env         (Git Bash)
#
# .env는 .gitignore에 있어 저장소에 올라가지 않습니다.
# 값을 바꾼 뒤에는 제어판(또는 감시)을 재시작해야 반영됩니다.
# 따옴표는 붙이지 마세요. 값에 # 이 들어가면 그 뒤가 주석으로 잘립니다.

# ── 보고서 생성 (필수) ────────────────────────────────────────────────
# console.anthropic.com → API Keys 에서 발급
ANTHROPIC_API_KEY=sk-ant-api03-...

# 구간 판정/요약 모델을 바꾸고 싶을 때만 (기본값 둘 다 claude-sonnet-5)
# SEGMENT_MODEL=claude-opus-5
# REPORT_MODEL=claude-sonnet-5


# ── 메일 알림 (선택) ─────────────────────────────────────────────────
# 아래 4개가 없으면 메일 발송만 조용히 건너뛰고 나머지는 정상 동작합니다.
# 받는 사람은 제어판 "알림 설정" 탭에서 관리합니다 (여기 아닙니다).

# 보내는 서버 주소. Gmail은 smtp.gmail.com, 네이버는 smtp.naver.com,
# 기관 메일이면 전산팀에 문의하세요.
SMTP_HOST=smtp.gmail.com

# 587 = STARTTLS (대부분 이것), 465 = SSL
SMTP_PORT=587

# 보내는 계정 (로그인 아이디)
SMTP_USER=보내는계정@gmail.com

# ⚠ Gmail은 계정 비밀번호가 아니라 "앱 비밀번호"입니다.
#    2단계 인증을 켠 뒤 myaccount.google.com/apppasswords 에서 발급하면
#    16자리 문자열이 나옵니다. 띄어쓰기는 빼고 붙여 넣으세요.
SMTP_PASS=abcdefghijklmnop

# 받는 사람에게 보이는 발신자 이름 (생략하면 SMTP_USER가 그대로 보입니다)
SMTP_FROM=국캐치 <보내는계정@gmail.com>

# 기본 수신자를 제어판 대신 여기서 지정하고 싶을 때만 (쉼표로 여러 명).
# 제어판 "알림 설정"에 입력한 값이 있으면 그쪽이 우선합니다.
# MAIL_TO=받는사람@example.com


# ── Dooray 알림 (선택) ───────────────────────────────────────────────
# 두레이 메신저로 알림을 받고 싶을 때만. 봇 → 들어오는 웹훅 URL.
# DOORAY_WEBHOOK_URL=https://hook.dooray.com/services/...
